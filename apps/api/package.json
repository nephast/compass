{
  "name": "@compass/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "dev": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/main.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@compass/llm": "*",
    "@compass/pg": "*",
    "@compass/telemetry": "*",
    "aws-jwt-verify": "^5.0.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "vitest": "^4.1.0"
  }
}
