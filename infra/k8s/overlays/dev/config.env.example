# Shape of config.env, which scripts/k8s-deploy.sh writes from SSM. Never commit
# the real file: it holds account-specific identifiers (public repo).
AWS_REGION=eu-west-1
DOCUMENTS_BUCKET=compass-dev-documents-XXXXXXXXXXXX
COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
DB_HOST=compass-dev.xxxxxxxxxxxx.eu-west-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=compass
DB_USER=compass_app
AGENT_SECRET_ID=compass/dev/agent
LLM_EMBEDDING_PROVIDER=bedrock
LLM_COMPLETION_PROVIDER=bedrock
