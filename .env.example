# Copy to .env and fill in. Never commit the real .env file.

# --- AWS ---
AWS_REGION=eu-west-1
AWS_PROFILE=compass-dev

# --- LLM providers (see ADR: LlmProvider abstraction, COMPASS-19) ---
# Bedrock uses your AWS credentials — no key needed here, just request model
# access in the Bedrock console first (Anthropic/Titan models, whichever you use).
LLM_PROVIDER=bedrock          # bedrock | openrouter
OPENROUTER_API_KEY=           # only needed if LLM_PROVIDER=openrouter, or as fallback

# --- Database (local dev only — real env uses IAM auth, see COMPASS-13) ---
DATABASE_URL=postgresql://compass:compass@localhost:5432/compass

# --- Cognito (filled in after COMPASS-15) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- Local dev ---
# Its presence is what points the AWS SDK clients at LocalStack instead of
# real AWS (see apps/ingestion/src/aws-config.ts) — leave it unset in any
# deployed environment.
LOCALSTACK_ENDPOINT=http://localhost:4566
RAW_DOCUMENTS_BUCKET=compass-raw-documents
